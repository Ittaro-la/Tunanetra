# ==========================================================
# Spider Sense - nilai environment lokal
# Salin ke .env (di root project). JANGAN commit .env.
# ==========================================================

# Groq (primary AI + Speech-to-Text)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_OUTPUT_TOKENS=220
GROQ_REASONING_EFFORT=low
STT_LANGUAGE=id

# MongoDB + Ubidots (existing integrations retained)
MONGODB_URI=
UBIDOTS_TOKEN=
UBIDOTS_DEVICE_LABEL=spider-sense

# TTS (MP3): Edge TTS -> gTTS fallback
# Values: auto | edge | gtts
TTS_PROVIDER=auto
TTS_LANGUAGE=id-ID
TTS_VOICE=id-ID-ArdiNeural
# Bila ESP32 tidak terhubung (mis. hanya serial USB), suara diputar di speaker komputer backend.
# Keluaran normal tetap ke speaker ESP32 lewat WebSocket.
LOCAL_AUDIO_PLAYBACK=true

# ==========================================================
# ESP32 sebagai remote controller 3 tombol Quick Command
# Tombol 1 -> object_detection     -> Deteksi Objek
# Tombol 2 -> expression_detection -> Deteksi Ekspresi
# Tombol 3 -> sign_detection       -> Deteksi Rambu Lalu Lintas
# ==========================================================
# Kosongkan untuk jaringan rumah/lab tepercaya. Bila diisi, firmware harus
# mengirim nilai yang sama (ESP32_TOKEN di secrets.h).
ESP32_SHARED_TOKEN=
# Debounce lapis kedua di server, mencegah satu tekanan terbaca berkali-kali.
ESP32_EVENT_COOLDOWN_MS=700
# Monitor SSE opsional (GET /api/esp32/stream): batas koneksi dan detak.
ESP32_MAX_STREAM_CLIENTS=8
ESP32_SSE_HEARTBEAT_SECONDS=15

# Jalur serial/USB opsional (dipakai bila ESP32 tidak memakai Wi-Fi).
# Perlu: pip install pyserial
ESP32_SERIAL_ENABLED=false
# auto = deteksi port sendiri. Atau isi manual: COM11 (Windows), /dev/ttyUSB0 (Linux).
ESP32_SERIAL_PORT=auto
ESP32_SERIAL_BAUDRATE=115200
ESP32_SERIAL_DEVICE_ID=esp32-serial

# ==========================================================
# Kamera: ESP32-CAM (sumber utama). Firmware: firmware/esp32_cam
# ==========================================================
CAMERA_SOURCE=esp32cam
# Alamat kamera di jaringan yang sama dengan backend. Gunakan IP tetap (reservasi DHCP).
ESP32CAM_URL=http://192.168.137.200/
# Samakan dengan CAM_TOKEN di firmware/esp32_cam/secrets.h (kosongkan bila tidak dipakai).
ESP32CAM_TOKEN=
ESP32CAM_TIMEOUT_SECONDS=8
ESP32CAM_CONNECT_TIMEOUT_SECONDS=3
SIGN_WATCH_INTERVAL_SECONDS=0.5
ESP32CAM_RETRIES=1
# Jeda antar frame pada burst (ms) dan jumlah percobaan "frame tertajam".
ESP32CAM_BURST_GAP_MS=400
ESP32CAM_BEST_OF=1
# true: nyalakan LED flash kamera saat memotret (gelap). Boros daya.
ESP32CAM_FLASH=true
SAVE_CAPTURES=false
SAVE_DETECTION_IMAGES=true

# Server / sessions
HOST=0.0.0.0
PORT=5000
# Halaman web lama (folder web/) sebagai monitor OPSIONAL. Tidak dibutuhkan sistem utama.
WEB_UI_ENABLED=true
SESSION_TTL_SECONDS=3600
PROMPT_REPEAT_GUARD_SECONDS=3.0

# Webcam USB - HANYA untuk menguji AI tanpa perangkat keras (CAMERA_SOURCE=webcam).
# WEBCAM_SOURCE=0
# WEBCAM_WIDTH=1280
# WEBCAM_HEIGHT=720
# WEBCAM_FPS=30
# WEBCAM_CAPTURE_BURST=3
# WEBCAM_CAPTURE_GAP_MS=20

# YOLOv5 - local model/repository are included under model/
# Primary pass: fast enough for CPU, sensitive enough for common objects.
YOLO_DEVICE=cpu
YOLO_CONFIDENCE=0.40
YOLO_HIGH_CONFIDENCE=0.65
YOLO_SMALL_OBJECT_CONFIDENCE=0.50
YOLO_IOU=0.45
YOLO_IMAGE_SIZE=640
YOLO_MAX_DETECTIONS=20
YOLO_MIN_AREA_RATIO=0.00003
YOLO_SMALL_AREA_RATIO=0.0010
YOLO_MIN_BOX_PX=4

# Only runs when primary detection is empty.
YOLO_ADAPTIVE_FALLBACK=true
YOLO_FALLBACK_CONFIDENCE=0.40
YOLO_FALLBACK_IMAGE_SIZE=768
YOLO_FALLBACK_SMALL_OBJECT_CONFIDENCE=0.50
YOLO_FALLBACK_MIN_AREA_RATIO=0.00002
YOLO_FALLBACK_MIN_BOX_PX=3

# Final recovery for an object deliberately pointed at near the frame center.
YOLO_CENTER_CROP_FALLBACK=true
YOLO_CENTER_CROP_RATIO=0.72
YOLO_CENTER_CROP_IMAGE_SIZE=768
YOLO_CENTER_CROP_CONFIDENCE=0.40

YOLO_LOW_LIGHT_ENHANCE=true
YOLO_LOW_LIGHT_THRESHOLD=62
YOLO_WARMUP=false
YOLO_HISTORY=3
YOLO_STABLE_HITS=2
YOLO_TRACK_IOU=0.25

# Debug only: save snapshots that remain empty after all YOLO passes.
YOLO_DEBUG_SAVE_EMPTY=false

# Deteksi rambu lalu lintas (model/rambu_yolo.pt = YOLO26s, 40 kelas; model lama: model/rambu_yolo_old.pt, pakai SIGN_MODEL_PATH untuk rollback)
SIGN_MIN_CONFIDENCE=0.35
SIGN_RELIABLE_CONFIDENCE=0.50
SIGN_IMAGE_SIZE=640
SIGN_REPEAT_COOLDOWN=5
SIGN_IMAGE_MIRRORED=false

# Quick Commands: 1..3 frames; >=2 enables burst confirmation.
QUICK_OBJECT_FRAMES=1
AI_CPU_THREADS=2
IMAGE_BLUR_WARNING=25
OBSTACLE_WARNING_CM=50
OBSTACLE_LARGE_AREA=0.08
# Empty = no camera distance estimates, never fabricate cm.
DISTANCE_CALIBRATION_FILE=

# Walls/doors: prepare once with python tools/prepare_models.py --scene.
SCENE_SEGMENTATION=true
SCENE_DEVICE=cpu
SCENE_CONFIDENCE=0.65
SCENE_MIN_AREA_RATIO=0.015
# Optional override: absolute path to the downloaded model directory.
# SCENE_MODEL_PATH=

# Face position/size are normalized against full image width/height.
FACE_CENTER_WIDTH=0.40
FACE_CENTER_HEIGHT=0.70
FACE_MIN_WIDTH_RATIO=0.10
FACE_MIN_NEIGHBORS=6
FACE_MAX_WIDTH=800
EMOTION_DEVICE=cpu
EMOTION_MIN_CONFIDENCE=0.55
EMOTION_MIN_MARGIN=0.15

# Perbaikan ekspresi: tetap 7 logit internal, hanya 3 ekspresi ditampilkan.
QUICK_EXPRESSION_FRAMES=3
EMOTION_EXPRESSIVE_CONFIDENCE=0.70
EMOTION_EXPRESSIVE_MARGIN=0.20
FACE_MIN_CONTRAST=10
FACE_MIN_SHARPNESS=12

# Batas kata jawaban lisan (ai/output.py).
SPOKEN_MAX_WORDS=100
