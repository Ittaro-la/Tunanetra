# Salin menjadi .env. Hanya yang wajib: ESP32CAM_URL. Default lengkap: config/settings.py dan docs/AI_DETAIL.md.
ESP32CAM_URL=http://192.168.1.60
# Samakan dengan ESP32_TOKEN di firmware/esp32_multidevice/esp32_spider/secrets.h (kosongkan bila tidak dipakai)
ESP32_SHARED_TOKEN=

# Deteksi objek dipicu ultrasonik
OBJECT_TRIGGER_CM=100
OBJECT_AUTO_COOLDOWN_SECONDS=45

# Deteksi rambu terus-menerus: kalibrasi 85 px = 2 m pada gambar 640 px
SIGN_WATCH_ENABLED=true
SIGN_REF_PIXELS=85
SIGN_REF_DISTANCE_M=2.0
SIGN_IMAGE_MIRRORED=true

# Opsional
GROQ_API_KEY=
MONGODB_URI=
UBIDOTS_TOKEN=
